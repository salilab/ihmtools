include README.md
recursive-include examples *.py *.md
recursive-include examples/9A9W/data *.cif *.csv *.png
recursive-include examples/9A8W/data *.cif *.csv *.png
# MANIFEST globs the working directory, not git, so local scratch has to be
# pruned here as well as ignored -- untracking it is not enough.
prune examples/9A8W_test
prune examples/9A9W_test
recursive-exclude examples *_test *_test/*

# generated output, and the collection example (11 MB), stay out of the sdist.
# By pattern, not by exact name: a local run leaves assembled.cif, and a second
# one can leave assembled_1.cif, which an exact exclude would have shipped.
recursive-exclude examples/9A9W/data assembled*.cif
recursive-exclude examples/9A8W/data assembled*.cif
prune examples/G_1000003
